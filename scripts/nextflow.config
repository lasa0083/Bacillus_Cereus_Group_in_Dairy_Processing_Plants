profiles {
    keb {
        process {
            executor = "slurm"
            cpus = 1
            time = "00:10:00"
            queueSize = 3000
            submitRateLimit = 100
            clusterOptions = "-A hpc2n2026-126"
            exitStatusReadTimeoutMillis = '5000000'
        }
        singularity {
            enabled = true
        }
        env {
            SLURM_JOB_ID = "$SLURM_JOB_ID"
        }
    }
}
